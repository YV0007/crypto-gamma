# Secrets — MUST be ignored before the first commit
.env
*.key

# Data — never commit; regenerable by script
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep

# Figures are regenerable (scripts/reproduce_all.sh); curated copies live in docs/figures.
# Tables are small and are the machine-readable results the README cites, so they are tracked.
outputs/figures/*
!outputs/**/.gitkeep

# Fetcher checkpoints
*.sqlite
*.sqlite3
*.db

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS
.DS_Store

# Runtime logs
logs/

# Stray scratch files
\# data encapsualtion - bundling of data .py

# Internal planning notes, kept local
PLAN_TO_DECK.md
